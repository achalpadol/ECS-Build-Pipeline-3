pipeline {
    agent any
    environment {
        AWS_REGION       = 'ap-south-1'
        AWS_ACCOUNT_ID   = '552940445807'
        ECR_REGISTRY     = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REGISTRY_URL = "https://${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        // DB images
        DB_IMAGE_DEV  = 'app3-db-dev'
        DB_IMAGE_QA   = 'app3-db-qa'
        DB_IMAGE_UAT  = 'app3-db-uat'
        DB_IMAGE_PROD = 'app3-db-prod'

        // AWS credentials
        AWS_CREDENTIALS = 'aws'

        // DB Docker build context
        BUILD_CONTEXT = './db'
        DB_DOCKERFILE = './db/Dockerfile'
    }

    parameters {
        choice(
        name: 'Environment',
        choices: ['dev', 'qa', 'uat', 'prod'],
        description: 'Select the deployment environment'
    )

    string(
        name: 'IMAGE_TAG',
        defaultValue: '',
        description: 'Existing DEV image tag to promote. Required for QA/UAT/PROD.'
    )
}

    stages {

        stage('Get ECS Cluster') {
            steps {
                script {
                    env.ECS_CLUSTER = getECSCluster(params.Environment)
                    echo "ECS_CLUSTER = ${env.ECS_CLUSTER}"
                }
            }
        }

        // DEV - BUILD & PUSH
        stage('Dev - Build & Push DB') {
            when {
                expression {
                    params.Environment == 'dev'
                }
            }
            steps {
                script {
                    buildAndPush(
                        "${env.DB_IMAGE_DEV}",
                        "${env.BUILD_CONTEXT}"
                    )
                }
            }
        }

        // QA - PROMOTE IMAGE
        stage('Promote Database Dev to QA') {
            when {
                expression {
                    params.Environment == 'qa'
                }
            }
            steps {
                script {
                    promoteImage(
                        "${env.DB_IMAGE_DEV}",
                        "${env.DB_IMAGE_QA}"
                    )
                }
            }
        }

        // UAT - PROMOTE IMAGE
        stage('Promote Database QA to UAT') {
            when {
                expression {
                    params.Environment == 'uat'
                }
            }
            steps {
                script {
                    promoteImage(
                        "${env.DB_IMAGE_QA}",
                        "${env.DB_IMAGE_UAT}"
                    )
                }
            }
        }

        // PROD APPROVAL
        stage('Production Approval') {
            when {
                expression {
                    params.Environment == 'prod'
                }
            }
            steps {
                input(
                    message: 'Promote DB image to PROD?',
                    ok: 'Approve Production Deployment'
                )
            }
        }

        // PROD - PROMOTE IMAGE
        stage('Promote Database UAT to PROD') {
            when {
                expression {
                    params.Environment == 'prod'
                }
            }
            steps {
                script {
                    promoteImage(
                        "${env.DB_IMAGE_UAT}",
                        "${env.DB_IMAGE_PROD}"
                    )
                }
            }
        }

        // DEPLOY DB
        stage('Deploy DB') {
            when {
                expression {
                    params.Environment == 'prod'
                }
            }
            steps {
                script {
                    def TASK_FAMILY = getTaskFamily(params.Environment)
                    def ECS_SERVICE = getECSService(params.Environment)

                    deployToECS(
                        './db/db-task-definition.json',
                        TASK_FAMILY,
                        ECS_SERVICE
                    )
                }
            }
        }
    }

    // POST
    post {
        always {
            deleteDir()
        }
    }
}


// FUNCTION 1 - BUILD AND PUSH DB IMAGE
def buildAndPush(String DB_IMAGE, String BUILD_CONTEXT) 
{
    def IMAGE_URI =
        "${env.ECR_REGISTRY}/${DB_IMAGE}:${env.GIT_COMMIT}"

    echo "Building image:"
    echo "${IMAGE_URI}"

    def image = docker.build(
        IMAGE_URI,
        "-f ${env.DB_DOCKERFILE} ${BUILD_CONTEXT}"
    )

    docker.withRegistry(
        "${env.ECR_REGISTRY_URL}",
        "ecr:${env.AWS_REGION}:${env.AWS_CREDENTIALS}"
    ) {

        image.push()
    }
}

// FUNCTION 2 - PROMOTE DB IMAGE
def promoteImage(String sourceImage, String targetImage)
 {
    def IMAGE_TAG = params.IMAGE_TAG
    def SOURCE_IMAGE_URI = "${env.ECR_REGISTRY}/${sourceImage}:${IMAGE_TAG}"
    def TARGET_IMAGE_URI = "${env.ECR_REGISTRY}/${targetImage}:${IMAGE_TAG}"

    echo "Source image:"
    echo "${SOURCE_IMAGE_URI}"

    echo "Target image:"
    echo "${TARGET_IMAGE_URI}"

    // Pull source image from ECR
    echo "Pulling source DB image..."

    docker.withRegistry(
        "${env.ECR_REGISTRY_URL}",
        "ecr:${env.AWS_REGION}:${env.AWS_CREDENTIALS}"
    ) {
        docker.image(
            SOURCE_IMAGE_URI
        ).pull()
    }

    // Tag image for target environment
    echo "Tagging image for target environment..."
    sh """
        docker tag \
        ${SOURCE_IMAGE_URI} \
        ${TARGET_IMAGE_URI}
    """

    // Push target image to ECR
    echo "Pushing target DB image..."
    docker.withRegistry(
        "${env.ECR_REGISTRY_URL}",
        "ecr:${env.AWS_REGION}:${env.AWS_CREDENTIALS}"
    ) {
        docker.image(
            TARGET_IMAGE_URI
        ).push()
    }

    echo "DB image promoted successfully."
}

// FUNCTION 3 - TASK DEFINITION FUNCTION
def deployToECS(
    String taskDefinitionFile,
    String taskFamily,
    String ecsService
) {
    def environment = params.Environment
    def commitId    = env.IMAGE_TAG
    def region      = env.AWS_REGION
    def cluster     = getECSCluster(environment)

    // Replace environment
    sh """
        sed -i 's|\\\${ENV}|${environment}|g' ${taskDefinitionFile}
        sed -i 's|\\\${COMMIT_ID}|${commitId}|g' ${taskDefinitionFile}
    """

    echo "Task definition after image replacement:"

    sh """
        grep '"image"' ${taskDefinitionFile}
    """

    echo "Registering ECS task definition..."

    def taskRevision = sh(
        script: """
            aws ecs register-task-definition \
                --cli-input-json file://${taskDefinitionFile} \
                --region ${region} \
                --query 'taskDefinition.revision' \
                --output text
        """,
        returnStdout: true
    ).trim()

    echo "Task definition revision: ${taskRevision}"
    echo "Updating ECS service..."

    sh """
        aws ecs update-service \
            --cluster ${cluster} \
            --service ${ecsService} \
            --task-definition ${taskFamily}:${taskRevision} \
            --region ${region}
    """

    echo "ECS deployment completed successfully."
}
// FUNCTION 4 - GET ECS CLUSTER
def getECSCluster(String environment)
{
    def clusters = [
        dev  : 'dev-app-cluster',
        qa   : 'qa-app-cluster',
        uat  : 'uat-app-cluster',
        prod : 'prod-app-cluster'
    ]

    return clusters[environment]
}

// FUNCTION 5 - GET TASK FAMILY
def getTaskFamily(String environment)
{
    def taskFamilies = [
        dev  : 'dev-db',
        qa   : 'qa-db',
        uat  : 'uat-db',
        prod : 'prod-db'
    ]

    return taskFamilies[environment]
}

// FUNCTION 6 - GET ECS SERVICE
def getECSService(String environment)
{
    def services = [
        dev  : 'dev-db-service',
        qa   : 'qa-db-service',
        uat  : 'uat-db-service',
        prod : 'prod-db-service'
    ]

    return services[environment]
}
