{
  "family": "qa-frontend",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "552940445807.dkr.ecr.ap-south-1.amazonaws.com/app3-frontend-${ENV}:${COMMIT_ID}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "BACKEND_HOST",
          "value": "backend.ecs.dev.local"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/app3-frontend-task-definition",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::552940445807:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
