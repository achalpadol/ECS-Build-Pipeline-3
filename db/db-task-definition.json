{
  "containerDefinitions": [
    {
      "name": "db",
      "image": "552940445807.dkr.ecr.ap-south-1.amazonaws.com/app3-db-${ENV}:${COMMIT_ID}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3306,
          "hostPort": 3306,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "MYSQL_ROOT_PASSWORD",
          "value": "Achal123"
        },
        {
          "name": "MYSQL_DATABASE",
          "value": "example"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/app3-db-task-definition",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "db"
        }
      }
    }
  ],
  "family": "${ENV}-db",
  "executionRoleArn": "arn:aws:iam::552940445807:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}